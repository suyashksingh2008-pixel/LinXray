#  AUTO-FETCH ENGINE

def fetch_latest_jpeg(folder_path: str) -> str:
    """Scans the specified folder and auto-fetches the most recently modified .jpeg file."""
    search_pattern = os.path.join(folder_path, "*.jpeg")
    matching_files = glob.glob(search_pattern)

    if not matching_files:
        raise FileNotFoundError(f"No .jpeg image files found in: {folder_path}")

    # Identify the newest file based on last modification timestamp
    latest_file = max(matching_files, key=os.path.getmtime)
    print(f"🎯 Auto-fetched latest capture: {latest_file}")
    return latest_file



#  EXPORT & PERSISTENCE


def save_report_to_newz(report_text: str, source_image: str) -> str:
    """Serializes the analysis into JSON and saves it to the newz folder."""
    # Ensure the newz directory exists
    if not os.path.exists(SAVE_FOLDER):
        os.makedirs(SAVE_FOLDER)

    output_filename = "threat_analysis_report.json"
    output_path = os.path.join(SAVE_FOLDER, output_filename)

    payload = {
        "status": "success" if report_text != "all our servers are busy please try again later in 10 minutes" else "failed",
        "source_image": os.path.basename(source_image),
        "ai_analysis": report_text
    }

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=4)

    print(f"💾 Report successfully written to: {output_path}")
    return output_path


#  AI WATERFALL PIPELINE

def analyze_image_waterfall(image_path: str, gemini_key: str, github_token: str, reka_key: str) -> str:
    """Executes visual threat detection via Reka AI, falling back to Gemini, then GitHub Models."""
    prompt = """
    You are a senior Cyber Threat Intelligence analyst for LinXray.
    Examine this screenshot of a potentially malicious website.
    Provide a structured security report identifying:
    1. Deceptive UI Elements (brand spoofing, fake alerts, misleading CTA buttons)
    2. Phishing & Behavioral Indicators (domain anomalies, fake urgency, suspicious input forms)
    3. Final Risk Assessment (Risk Index 0-100, Threat Classification, and Recommended Action)
    
    IMPORTANT: 
    If the website appears to be clean, legitimate, and low risk, you must explicitly state that the website is clean and safe to use.
    - Differentiate between core website threats and third-party ad clutter. Do not flag a legitimate website as malicious solely because it contains deceptive banner ads (e.g., fake "Download" buttons or alerts inside ad slots).
    """

    # Pre-process the image for Reka and GitHub
    try:
        with open(image_path, "rb") as img_file:
            base64_image = base64.b64encode(img_file.read()).decode("utf-8")
    except Exception as e:
        print(f"⚠️ Image read error: {e}")
        return "all our servers are busy please try again later in 10 minutes"

    # 1. Primary Engine: Reka AI
    try:
        print("⚡ Sending image to Reka AI API...")
        reka_client = Reka(api_key=reka_key)
        
        response = reka_client.chat.create(
            messages=[
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": prompt},
                        {"type": "image_url", "image_url": f"data:image/jpeg;base64,{base64_image}"}
                    ]
                }
            ],
            model="reka-flash",
        )
        print("✅ Analysis generated by Reka AI.")
        return response.responses[0].message.content

    except Exception as reka_err:
        print(f"⚠️ Reka AI request failed: {reka_err}")
        print("🔄 Rerouting request to Gemini API...")

    # 2. Secondary Engine: Gemini
    try:
        client = genai.Client(api_key=gemini_key)
        screenshot = PIL.Image.open(image_path)

        response = client.models.generate_content(
            model="gemini-3.6-flash",
            contents=[prompt, screenshot]
        )
        print("✅ Analysis generated by Gemini.")
        return response.text

    except Exception as gemini_err:
        print(f"⚠️ Gemini fallback failed: {gemini_err}")
        print("🔄 Rerouting request to GitHub Models...")

    # 3. Tertiary Engine: GitHub Models (Copilot / GPT-4o-mini)
    try:
        openai_client = OpenAI(
            base_url="https://models.inference.ai.azure.com",
            api_key=github_token
        )

        response = openai_client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": prompt},
                        {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{base64_image}"}}
                    ]
                }
            ],
            max_tokens=800
        )
        print("✅ Analysis generated by GitHub Models.")
        return response.choices[0].message.content

    except Exception as github_err:
        print(f"⚠️ GitHub Models fallback failed: {github_err}")

    #  4. Absolute Failure State 
    return "all our servers are busy please try again later in 10 minutes"



#  MAIN PIPELINE EXECUTION

if __name__ == "__main__":
    try:
        # Step 1: Auto-detect the latest .jpeg image from the target directory
        auto_detected_image = fetch_latest_jpeg(WATCH_FOLDER)

        # Step 2: Run through the AI waterfall (Reka -> Gemini -> GitHub)
        report = analyze_image_waterfall(auto_detected_image, GEMINI_KEY, GITHUB_TOKEN, REKA_KEY)

        # Step 3: Automatically dump the JSON report to the newz folder
        save_report_to_newz(report, auto_detected_image)

        # Step 4: Display the terminal report
        print("\n================== SECURITY REPORT ==================")
        print(report)

    except Exception as e:
        print(f"❌ Pipeline Execution Error: {e}")
